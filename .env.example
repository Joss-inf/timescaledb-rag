# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=rag
DB_PASSWORD=rag_password
DB_NAME=rag
DB_POOL_SIZE=20

# Embeddings (local SentenceTransformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64
EMBEDDING_NORMALIZE=true

# Reranker (local cross-encoder)
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_TOP_K=10

# Chunking
CHUNKING_DEFAULT_STRATEGY=hierarchical
CHUNKING_DEFAULT_CHUNK_SIZE=512
CHUNKING_DEFAULT_OVERLAP=64
CHUNKING_MIN_CHUNK_SIZE=128
CHUNKING_MAX_CHUNK_SIZE=1024

# Auth
AUTH_KEY_PREFIX=rag_
AUTH_KEY_LENGTH=48
AUTH_HASH_TIME_COST=3
AUTH_HASH_MEMORY_COST=65536
AUTH_HASH_PARALLELISM=4
AUTH_PERMISSION_CACHE_TTL=60
AUTH_PERMISSION_CACHE_MAX_SIZE=1024

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
